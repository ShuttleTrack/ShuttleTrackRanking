# Copy to .env before docker compose up: cp .env.example .env
# DATABASE_URL is overridden by docker-compose.yml when using Compose (uses db:3306).
# NEXT_PUBLIC_BACKEND_URL is gone - the Java backend was fully decommissioned (MIGRATION_PLAN.md
# Phase 8), nothing in this app calls it anymore.

NEXT_PUBLIC_APP_URL=http://localhost:3333
NEXTAUTH_URL=http://localhost:3333
NEXTAUTH_SECRET=change-me-to-a-long-random-string
NEXT_AUTH_ENABLED=false

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

ALLOWED_ADMIN_EMAILS=

TELEGRAM_BOT_TOKEN=

SENTRY_AUTH_TOKEN=

NEXT_PUBLIC_BUILD_IDENTIFIER=local-dev
DATABASE_URL=
